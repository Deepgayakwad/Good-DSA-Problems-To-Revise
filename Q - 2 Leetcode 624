class Solution {
public:
    int maxDistance(vector<vector<int>>& arrays) {
        
          // step1 find out the highest positive number
          int maxi1 = INT_MIN;
          int maxIdx1 = -1;

          int m = arrays.size();

          for(int i = 0 ; i < m;i++){
              
                vector<int>temp = arrays[i];

                if(temp[temp.size()-1]>maxi1){
                     maxi1 = temp[temp.size()-1];
                     maxIdx1 = i;
                }
          }

          int mini1 = INT_MAX;
          int minIdx1 = -1;

          for(int i = 0;i<m;i++){
               
                 vector<int>temp = arrays[i];
                 if(temp[0] < mini1 && maxIdx1 != i){
                      mini1 = temp[0];
                      minIdx1 = i;
                 }
          }

          // consider minimum element and find its corresponding maximum element
          int mini2 = INT_MAX;
          int minIdx2 = -1;

          int maxi2 = INT_MIN;
          int maxIdx2 = -1;

          for(int i = 0;i < m;i++){
               
                vector<int>temp = arrays[i];
                if(temp[0] < mini2){
                      mini2 = temp[0];
                      minIdx2 = i;
                }
          }

          for(int i = 0;i < m;i++){
              
                vector<int>temp = arrays[i];

                if(temp[temp.size()-1] > maxi2 && minIdx2 != i){
                      maxi2  = temp[temp.size()-1];
                      maxIdx2 = i;
                }
          }

          return max(abs(maxi1-mini1),abs(maxi2-mini2));
         
    }
};
