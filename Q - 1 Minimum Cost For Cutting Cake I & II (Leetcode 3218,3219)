class Solution {
public:
    int minimumCost(int m, int n, vector<int>& horizontalCut, vector<int>& verticalCut) {
        
            // case1 cut row wise 

            int row = m;
            int col = n;

            int rowAns = 0;
            rowAns = accumulate(horizontalCut.begin(),horizontalCut.end(),0);

            for(int i = 0; i < verticalCut.size();i++){
                  
                   rowAns += (verticalCut[i]*m);
            }

           // case2 cut col wise 
            int colAns = 0;
            colAns = accumulate(verticalCut.begin(),verticalCut.end(),0);
            
            for(int i = 0; i <horizontalCut.size();i++){
                  
                    colAns += (horizontalCut[i]*n);
            }

            return min(rowAns,colAns);
    }
};
