class Solution {
public:
    int minimumTeachings(int n, vector<vector<int>>& languages, vector<vector<int>>& friendships) {
        

        set<int>sadUsers;

        for(int i = 0; i < friendships.size(); i++){
              
                int f1 = friendships[i][0];
                int f2 = friendships[i][1];

                vector<int>lF1 = languages[f1-1];
                vector<int>lF2 = languages[f2-1];

                set<int>st;

                for(int i  = 0;i<lF1.size();i++){
                      st.insert(lF1[i]);
                }

               bool find = false;
                for(int i = 0;i<lF2.size();i++){
                    if(st.find(lF2[i]) != st.end()){
                          find = true;
                          break;
                    }
                }

                if(!find){
                      sadUsers.insert(f1);
                      sadUsers.insert(f2);
                }
        }


        // unordered_map for lang->CntUser 
         
         unordered_map<int,int>langCnt;
         for(int element:sadUsers){
               
                vector<int>knownLang = languages[element-1];
                
                for(int i = 0;i<knownLang.size();i++){
                      
                       langCnt[knownLang[i]]++;
                }
         }

         int maxi = 0;

         for(auto it:langCnt){
              maxi = max(maxi,it.second);
         }

         return sadUsers.size() - maxi;
    }
};
